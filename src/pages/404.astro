---
import AppLayout from '../layouts/AppLayout.astro';

Astro.response.status = 404;
---
<AppLayout title="Page not found">
  <div class="empty-state">
    <p class="eyebrow">404 / AN UNWRITTEN CHAPTER</p>
    <h1>Nothing on this shelf.</h1>
    <p>The page may have moved, or the address might be incomplete.</p>
    <a class="text-link" href="/books">Back to your books →</a>
  </div>
</AppLayout>
