{
  "name": "bookshelf-fe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/astro.mjs dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "node scripts/astro.mjs preview",
    "start:prod": "node scripts/start.mjs",
    "test": "STORYBOOK_DISABLE_TELEMETRY=1 vitest run --project unit",
    "test:stories": "STORYBOOK_DISABLE_TELEMETRY=1 vitest run --project storybook",
    "test:e2e": "playwright test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "storybook": "storybook dev -p 6006 --no-open --disable-telemetry",
    "build:storybook": "storybook build --disable-telemetry",
    "types:generate": "node scripts/generate-types.mjs"
  },
  "dependencies": {
    "@astrojs/node": "11.1.7",
    "@astrojs/react": "7.0.1",
    "@hookform/resolvers": "5.9.1",
    "@nanostores/persistent": "1.3.5",
    "@nanostores/react": "1.1.0",
    "@radix-ui/react-alert-dialog": "1.1.24",
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-label": "2.1.16",
    "@radix-ui/react-select": "2.3.8",
    "@radix-ui/react-slot": "1.4.0",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-table": "8.21.3",
    "astro": "7.3.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.55.0",
    "nanostores": "1.5.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.89.0",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "tailwind-merge": "2.6.1",
    "tailwindcss-animate": "1.0.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.0",
    "@storybook/addon-vitest": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitest/browser-playwright": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "autoprefixer": "10.6.1",
    "jsdom": "30.1.2",
    "msw": "2.15.0",
    "msw-storybook-addon": "3.0.3",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.29",
    "storybook": "10.6.1",
    "swagger2openapi": "7.0.8",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
